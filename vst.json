{
  "schema": "open-mpc.vst/v1",
  "id": "dust87",
  "uid": "LMD8",
  "name": "DUST '87",
  "vendor": "Lumina.Aerospace",
  "version": "v0.1.0",
  "license": "GPL-3.0-only",
  "category": "Instrument",
  "subcategories": ["Drum Sampler", "12-Bit", "Lo-Fi"],
  "midi": {
    "per_voice_channel": true,
    "combo_fallback_channel": 10,
    "pad_note_start": 36
  },
  "skin": {
    "touch_first": true,
    "min_target_px": 48,
    "accent_color": "#F5A623",
    "panel_bg": "#101319",
    "pad_grid": "4x3",
    "banks": ["A", "B", "C", "D"],
    "gestures": {
      "tap": "trigger_or_select",
      "tap_hold": "context_menu",
      "swipe": "bank_scroll",
      "drag": "parameter_value"
    }
  },
  "qlinks": [
    { "index": 1, "param": "filter_cutoff", "label": "FLT CUT", "min": 120, "max": 18000, "default": 11500 },
    { "index": 2, "param": "drive", "label": "DRIVE", "min": 0, "max": 1, "default": 0.4 },
    { "index": 3, "param": "decay", "label": "DECAY", "min": 0.02, "max": 3.0, "default": 0.35 },
    { "index": 4, "param": "pitch", "label": "PITCH", "min": -24, "max": 24, "default": 0 }
  ],
  "presets": {
    "schema": "lumina.plugin/v1",
    "factory_count": 64,
    "starter_count": 16,
    "quarantine_on_invalid": true
  },
  "targets": ["armhf-gen1", "aarch64-gen2", "x86_64-linux", "web-studio"]
}
